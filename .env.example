PORT=3000

# Optional. Without a key the same propose -> validate chain runs on a
# deterministic model so results stay reproducible. With a key, an
# OpenAI-compatible chat model proposes entities and a second call checks
# them. Ungrounded or conflicting model output is rejected.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
